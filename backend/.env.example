# OfferClaw 环境变量配置示例
# 复制为 .env 并填入真实值

# 数据库连接（默认 SQLite，开发用）
DATABASE_URL=sqlite:///./offerclaw.db

# 鉴权密钥
SECRET_KEY=dev-secret-key-12345

# CORS 允许的前端来源（逗号分隔）；生产环境务必改为具体域名
# 设为 * 将关闭 credentials（浏览器规范要求），默认放开本地开发端口
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 鉴权模式：demo（默认，任意 token 返回 demo-user-123）/ header（从 X-User-ID 头读取用户ID）/ jwt（校验 HS256 JWT，使用 SECRET_KEY）
AUTH_MODE=demo

# ===== Agent LLM 配置 =====

# Provider 选择：openai / mock
# 未配置 API Key 时自动降级为 mock
LLM_PROVIDER=openai

# 模型分级配置（推荐）：
# - Agent 编排用强模型（function calling 稳定），如 GLM-4.5 / DeepSeek-V3 / GPT-4o
# - 内容生成用快模型（简历/评分/面试准备），如 GLM-4-Flash / Qwen-Plus / DeepSeek-Chat
# - 未配置 GEN_* 时，内容生成复用 agent provider（单模型场景）

# Agent 编排模型（强模型）
AGENT_API_KEY=
AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_MODEL=glm-4.5

# 内容生成模型（快模型，可选；不配则复用 AGENT_*）
# GEN_API_KEY=
# GEN_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GEN_MODEL=glm-4-flash

# ===== 兼容旧配置（当未配置 AGENT_* 时使用） =====
# OpenAI 兼容协议配置
# 支持官方 / 国内代理 / 通义千问等兼容 OpenAI 协议的服务
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 通义千问示例（兼容 OpenAI 协议）：
# AGENT_API_KEY=sk-xxx
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_MODEL=qwen-plus

# DeepSeek 示例：
# AGENT_API_KEY=sk-xxx
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-chat

# LLM 重试次数（408/429/5xx 自动重试）
LLM_MAX_RETRIES=3
