# OfferCabin 环境变量配置示例
# 复制为 .env 并填入真实值
#
# 多用户 JWT 模式：注册登录、按账号隔离数据。
# 管理后台独立端口运行，与公开应用隔离。

# ===== 鉴权 =====
# AUTH_MODE: jwt（多用户，公网部署） / open（单用户本地，不鉴权——管理后台拒绝在 open 模式启动）
AUTH_MODE=jwt
# JWT 签名密钥：生产必改为强随机值（openssl rand -hex 32）
# 管理后台启动硬守卫会拒绝默认值 dev-secret-key-12345
SECRET_KEY=dev-secret-key-12345
# 通用令牌有效期（小时）；管理令牌有效期见 ADMIN_TOKEN_TTL_HOURS
AUTH_TOKEN_TTL_HOURS=168
# 注册邀请码（可选；设置后注册必须携带此码）
# REGISTRATION_INVITE_CODE=

# 数据库连接（默认 SQLite，开发用；生产建议 PostgreSQL）
DATABASE_URL=sqlite:///./offercabin.db

# CORS 允许的前端来源（逗号分隔）
# 内测本地开发默认放开常见端口；正式发布请改为具体域名
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ===== 管理后台（独立端口，与公开应用隔离）=====
# 监听地址：本地开发 127.0.0.1（仅本机）；容器内 0.0.0.0（端口映射收窄到宿主 127.0.0.1）
ADMIN_HOST=127.0.0.1
# 管理后台端口（与公开 8000 不同的独立端口）
ADMIN_PORT=8001
# 管理后台 CORS 来源（仅允许管理后台自身来源）
ADMIN_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
# 管理端口 IP 白名单（可选，逗号分隔；配置后仅白名单内 IP 可达管理后台）
# ADMIN_ALLOW_IPS=127.0.0.1,::1
# 管理令牌有效期（小时，比通用令牌更短）
ADMIN_TOKEN_TTL_HOURS=12

# ===== Agent LLM 配置 =====

# Provider 选择：openai / mock
# 未配置 API Key 时自动降级为 mock
LLM_PROVIDER=openai

# 模型分级配置（推荐）：
# - Agent 编排用强模型（function calling 稳定），如 GLM-4.5 / DeepSeek-V3 / GPT-4o
# - 内容生成用快模型（简历/评分/面试准备），如 GLM-4-Flash / Qwen-Plus / DeepSeek-Chat
# - 未配置 GEN_* 时，内容生成复用 agent provider（单模型场景）

# Agent 编排模型（强模型）
AGENT_API_KEY=
AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_MODEL=glm-4.5

# 内容生成模型（快模型，可选；不配则复用 AGENT_*）
# GEN_API_KEY=
# GEN_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GEN_MODEL=glm-4-flash

# ===== 兼容旧配置（当未配置 AGENT_* 时使用） =====
# OpenAI 兼容协议配置
# 支持官方 / 国内代理 / 通义千问等兼容 OpenAI 协议的服务
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 通义千问示例（兼容 OpenAI 协议）：
# AGENT_API_KEY=sk-xxx
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_MODEL=qwen-plus

# DeepSeek 示例：
# AGENT_API_KEY=sk-xxx
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-chat

# LLM 重试次数（408/429/5xx 自动重试）
LLM_MAX_RETRIES=3
