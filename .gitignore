# ===== OfferCabin 项目专用 =====

# 浏览器配置目录（含 Cookie、登录态、历史记录等敏感数据，严禁提交）
backend/data/

# 自动填表生成的临时截图/请求快照
backend/data/auto-fill-*.jpg
backend/data/auto-fill-req.json
backend/data/auto-fill-resp.json

# 运行时数据库（即使放非默认位置也排除）
offercabin.db
offercabin.db-journal

# 第三方参考项目（GPL-3.0，与 OfferCabin MIT 协议隔离，不提交到本仓库）
# 旧的 AI-Resume-Form-Filling-Assistant-master 已清理出项目
AI-Resume-Form-Filling-Assistant-master/

# 根目录的简历/资料类文件（含个人信息，留在项目根目录外）
/*.pdf
/*.PDF
/*.docx
/*.doc

# WorkBuddy 项目数据（会话内存等工具内部数据，不入仓）
.workbuddy/

# 打包 / 发布产物（构建产物，不入仓）
*.tar
*.tar.gz
*.zip
*.7z
*.rar

# 数据库备份文件（offercabin.db.bak_YYYYMMDD_HHMMSS 等，含数据不入仓）
*.db.bak*

# 宣传海报物料（临时生成的推广图，不入仓，单独管理）
poster-*.html
poster-*.png
poster-*.jpg

# 浏览器扩展（本地保留开发，不入仓 —— 已于 4c97a52 从仓库移除）
offercabin-extension/

# 数据库迁移前安全备份（本地保留，含数据不入仓）
backend/backups/

# 个人收款二维码（隐私，不入仓；部署时手动放置到 frontend/web/assets/donate/）
frontend/web/assets/donate/
docs/收款码/